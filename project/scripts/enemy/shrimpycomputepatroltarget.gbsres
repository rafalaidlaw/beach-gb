{
  "_resourceType": "script",
  "id": "f1800018-0000-4000-8000-shrimpy-patrol-target",
  "name": "Enemy/ShrimpyComputePatrolTarget",
  "description": "Reads visible player x (via Player/GetVisiblePlayerX into var_17) and ShrimpyMid's current x (into var_67), then writes a MOVE_TO target x into var_68. Caller writes the in-band natural offset (e.g. 96 or 128) into var_66 first. If shrimpy is below visiblePlayer+80 the target is forced to visiblePlayer+128 (retreat). If above visiblePlayer+128 the target is forced to visiblePlayer+96 (return). Otherwise target = visiblePlayer + var_66. Finally adds +24 px lead compensation so that by the time shrimpy arrives at the target, the player (who is constantly auto-running rightward) hasn't closed the gap.",
  "variables": {},
  "actors": {
    "f00518f5-62d0-449f-a94c-74618ae7b4fa": {
      "id": "f00518f5-62d0-449f-a94c-74618ae7b4fa",
      "name": "ShrimpyMid"
    }
  },
