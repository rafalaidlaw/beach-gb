{
  "_resourceType": "script",
  "id": "f0420042-0000-4000-8000-000000000001",
  "name": "Enemy/ClamRowCheck",
  "description": "Called by checkpoint triggers along the player's path. If the clam is still alive (var_12) and the player is not on the clam's current row, play the rolling animation and slide the clam +12 tiles right. The clam stays static if alive+same-row (player will hit it) or if dead (already stomped). Row is resolved at call time from the clam's y via Enemy/ClamResolveRow (writes row index to var_19), so this works after the clam respawns on a different row.",
  "variables": {},
  "actors": {
    "dce3a362-787b-415f-ab86-80390c03b1a8": {
      "id": "dce3a362-787b-415f-ab86-80390c03b1a8",
      "name": "Actor \u0000"
    }
  },
  "symbol": "script_clam_row_check",
  "script": [
    {
