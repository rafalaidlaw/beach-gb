      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "12"
          },
          "valueB": {
            "type": "number",
            "value": 0
          }
        },
        "__collapseElse": true
      },
      "children": {
        "true": [
          {
            "command": "EVENT_CALL_CUSTOM_EVENT",
            "args": {
              "customEventId": "f0430043-0000-4000-8000-000000000001",
              "__name": "Enemy/ClamResolveRow"
            },
            "id": "f0420042-0000-4000-8000-clam-rowcheck-resolve"
          },
